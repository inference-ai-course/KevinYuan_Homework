# Ignore everything by default
*

# But keep these specific files/folders
!.gitignore
!.gitattributes
!reward_data.jsonl
!compute_scores.ipynb

# Keep only the final checkpoint (checkpoint-6)
!reward_model/
!reward_model/checkpoint-6/
!reward_model/checkpoint-6/*.safetensors
!reward_model/checkpoint-6/config.json
!reward_model/checkpoint-6/tokenizer*.json
!reward_model/checkpoint-6/special_tokens_map.json
!reward_model/checkpoint-6/added_tokens.json
!reward_model/checkpoint-6/spm.model
!reward_model/README.md
